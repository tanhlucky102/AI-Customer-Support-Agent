# Copy file này thành .env rồi điền giá trị thật.
# .env đã nằm trong .gitignore — không commit.
# Khi dev, Agent Server và website shop demo dùng chung file này.
# Sinh secret ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(32))"

# ==== LLM ====
# Lấy key tại https://aistudio.google.com/apikey (miễn phí, ~1.500 request/ngày)
GEMINI_API_KEY=

LLM_MODEL=gemini/gemini-3.1-flash-lite

# Fallback khi chạm rate limit (HTTP 429/503)
# OPENROUTER_API_KEY=
# LLM_MODEL_FALLBACK=openrouter/qwen/qwen3.8-27b:free

# ==== Embedding ====
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ==== Agent Server ====
# URL công khai của Agent Server (loader.js và iframe widget được phục vụ từ đây)
AGENT_SERVER_URL=http://localhost:8000
# Thư mục chứa file cấu hình các shop (shops/*.yaml)
SHOPS_DIR=shops
# Rate limit cho widget công khai
RATE_LIMIT_PER_SESSION_PER_MINUTE=10
RATE_LIMIT_PER_IP_PER_MINUTE=30
DAILY_CHAT_QUOTA_PER_SHOP=500

# ==== Shop demo (demo_shop) ====
# Được tham chiếu trong shops/demo_shop.yaml
DEMO_SHOP_URL=http://localhost:8001
# Base URL của REST API đơn hàng mà Agent Server gọi
DEMO_SHOP_API_URL=http://localhost:8001
# Khóa server-to-server: Agent Server gửi khi gọi REST API của shop (Bearer)
DEMO_SHOP_API_KEY=
# Khóa ký JWT chat: shop dùng để ký, Agent Server dùng để verify — hai bên phải giống nhau
DEMO_SHOP_TOKEN_SECRET=
# Thời hạn JWT chat (giây)
CHAT_TOKEN_TTL_SECONDS=900
# Khóa ký session cookie đăng nhập của website demo
DEMO_SHOP_SESSION_SECRET=

# ==== Database ====
POSTGRES_USER=ati
POSTGRES_PASSWORD=change_me
POSTGRES_DB=support_agent
DATABASE_URL=postgresql+psycopg://ati:change_me@localhost:5432/support_agent

# ==== App ====
APP_ENV=development
