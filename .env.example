# Copy file này thành .env rồi điền giá trị thật. .env nằm trong .gitignore — không commit.
# Agent Server, hai website demo và bộ đánh giá dùng chung file này.
# Cách nhanh nhất: chạy `python scripts/setup_demo.py`, script tự sinh mọi khóa còn thiếu vào .env.
# Tự sinh một khóa: python -c "import secrets; print(secrets.token_urlsafe(32))"

# ==== LLM (AI Box, gọi qua LiteLLM) ====
# Chỉ đặt key trên máy chạy server; tuyệt đối không đưa vào widget.
AI_BOX_BASE_URL=https://api.ai-box.vn/v1
AI_BOX_MODEL=ds/deepseek-flash
AI_BOX_API_KEY=
LLM_MODEL=openai/ds/deepseek-flash
# 0 = tắt bước suy nghĩ ẩn của deepseek-flash (nhanh hơn ~2 lần); 1 = bật.
LLM_THINKING=0
LLM_TIMEOUT_SECONDS=30

# ==== RAG ====
# bge-m3 (mặc định) hoặc hash (chỉ dùng cho unit test).
RAG_EMBEDDER=bge-m3
# Nhánh từ khóa: bm25 (mặc định), tsrank (Postgres ts_rank_cd) hoặc none.
RAG_KEYWORD=bm25
RAG_RERANK=1
# Ngưỡng τ: điểm reranker tối thiểu để trả kết quả (dưới ngưỡng => no_results).
RAG_TAU=0.1
# 1 = Contextual Retrieval (LLM context sentence per chunk); off by default, see eval/results.
RAG_CONTEXTUAL=0
RAG_CHUNK_TOKENS=500
RAG_CHUNK_OVERLAP=80
# Nạp sẵn model embedding/reranker khi Agent Server khởi động.
RAG_WARMUP=1

# ==== Database (PostgreSQL + pgvector) ====
# Để trống: tự chạy PostgreSQL nhúng (gói pgserver) trong data/pgdata, không cần Docker.
# Docker Compose tự đặt biến này cho service agent.
DATABASE_URL=
# Thư mục dữ liệu của PostgreSQL nhúng (mặc định data/pgdata, hoặc %LOCALAPPDATA%ti-pgserver nếu đường dẫn có dấu).
PGDATA_DIR=
POSTGRES_PASSWORD=change_me

# ==== Agent Server ====
# URL công khai của Agent Server (loader.js và iframe widget được phục vụ từ đây).
AGENT_SERVER_URL=http://localhost:8000
# Origin khác được phép nhúng widget của demo_shop, phân tách bằng dấu phẩy.
WIDGET_ALLOWED_ORIGINS=
# Giới hạn POST /v1/chat: mỗi khách/phút, mỗi IP/phút, mỗi shop/ngày (0 = tắt).
RATE_LIMIT_PER_SESSION_PER_MINUTE=10
RATE_LIMIT_PER_IP_PER_MINUTE=30
DAILY_CHAT_QUOTA_PER_SHOP=500

# ==== Shop demo: Demo Mobile (cổng 8001, tích hợp mức 1 theo hợp đồng C2) ====
# Agent Server chỉ tự tạo shop demo khi có DEMO_SHOP_TOKEN_SECRET (setup_demo.py ghi vào) hoặc DEMO_SHOP=1.
# Triển khai thật cho shop khác: để trống phần này, cấp shop bằng `python -m agent_server.provision_shop`.
DEMO_SHOP_URL=http://localhost:8001
DEMO_SHOP_API_URL=http://localhost:8001
# Khóa server-to-server: Agent Server gửi khi gọi REST API của shop (Bearer).
DEMO_SHOP_API_KEY=
# Khóa ký JWT chat: shop ký, Agent Server kiểm tra — hai bên phải giống nhau.
DEMO_SHOP_TOKEN_SECRET=
DEMO_SHOP_SESSION_SECRET=
# Khóa ghi nội dung (FAQ, ưu đãi) và xem phiếu hỗ trợ của demo_shop.
DEMO_FAQ_WRITE_KEY=
CHAT_TOKEN_TTL_SECONDS=900
# external = widget của Agent Server; demo = chatbot quy tắc cục bộ (khi không chạy Agent Server).
WIDGET_MODE=external
SHOW_WIDGET=1

# ==== Shop thứ hai: Phụ Kiện Xanh (cổng 8003, API riêng, ánh xạ bằng commerce.json) ====
SECOND_SHOP_URL=http://localhost:8003
SECOND_SHOP_PUBLIC_KEY=pk_second_shop
SECOND_SHOP_API_KEY=
SECOND_SHOP_TOKEN_SECRET=
SECOND_SHOP_WRITE_KEY=
SECOND_SHOP_SESSION_SECRET=
# Docker: the Agent Server reaches the second shop's API at this address.
SECOND_SHOP_API_URL=

# ==== Sample Store (cổng 8002, tích hợp mức 0: chỉ FAQ) ====
SAMPLE_STORE_TOKEN_SECRET=
SAMPLE_STORE_WRITE_KEY=
